# Copy to supabase/functions/.env (gitignored) for local runs.
# Production: set the same names with `supabase secrets set --env-file ...` (see docs/auth-security.md).

# Auth "Send Email" hook secret, format v1,whsec_<base64>. Generate locally with:
#   echo "v1,whsec_$(openssl rand -base64 32)"
# In production, use the secret the dashboard generates for the hook.
# Locally the same value must also be visible to `supabase start` for config.toml
# (supabase/.env, or exported in the shell): see docs/auth-security.md.
SEND_EMAIL_HOOK_SECRET=v1,whsec_REPLACE_ME

# Key for the HMAC of device / sensitive-action codes. At least 32 chars: openssl rand -hex 32
DEVICE_CODE_SECRET=REPLACE_ME_WITH_64_HEX_CHARS

# Shared secret sent by the reports trigger (must equal the Vault secret report_alert_secret).
REPORT_ALERT_SECRET=local-report-alert-secret-change-me

# Public base URL of the Auth API, used in email links.
# Local: http://127.0.0.1:55321  Production: https://<project-ref>.supabase.co (or the custom auth domain)
AUTH_PUBLIC_URL=http://127.0.0.1:55321

# Must match [auth.email] otp_expiry (seconds / 60). Shown in the emails.
AUTH_OTP_EXPIRY_MINUTES=10

# Moderation inbox (Cloudflare Email Routing forwards it).
MODERATION_EMAIL=moderation@boolaa.ro

# Production only. When unset, mail goes to the local Mailpit over SMTP.
# RESEND_API_KEY=re_...
SMTP_HOST=supabase_inbucket_boolaa
SMTP_PORT=1025

# --- Push notifications (docs/push-notifications.md) ---------------------------
# Shared secret sent by the outbox triggers / pg_cron (must equal the Vault secret push_dispatch_secret).
PUSH_DISPATCH_SECRET=local-push-dispatch-secret-change-me
# Local only: record the would-be provider requests in public.push_debug_log instead of sending.
# Never set in production.
PUSH_DRY_RUN=1
# Web Push (VAPID). Generate a pair with: deno run supabase/functions/push-dispatch/gen-vapid.ts
VAPID_PUBLIC_KEY=REPLACE_ME_BASE64URL_65_BYTES
VAPID_PRIVATE_KEY=REPLACE_ME_BASE64URL_32_BYTES
VAPID_SUBJECT=mailto:hello@boolaa.ro
# APNs token auth (Apple Developer -> Keys). APNS_KEY_P8 = the .p8 file contents.
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=W5WKF2N472
# APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_TOPIC=ro.boolaa.app
# FCM HTTP v1: the whole Firebase service-account JSON on one line.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Link previews (optional locally). When set, the link-preview function requires the header
# x-link-preview-secret; store the same value in Vault as link_preview_secret.
# LINK_PREVIEW_SECRET=
