// Copy to Local.xcconfig (gitignored) and fill in values from `supabase status -o env`.
// xcconfig treats `//` as a comment start, so the URL scheme separator is written as `/$()/`.
SUPABASE_URL = http:/$()/127.0.0.1:55321
SUPABASE_ANON_KEY = <ANON_KEY from supabase status -o env>
// Web app serving /privacy and /terms (use http:/$()/localhost:3200 when running apps/boolaa-web locally).
WEB_BASE_URL = https:/$()/boolaa.app
