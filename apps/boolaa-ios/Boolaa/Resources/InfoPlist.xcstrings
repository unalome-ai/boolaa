  "strings": {
    "CFBundleDisplayName": {
      "comment": "App name under the icon; never translated",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa"
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
      "comment": "Calendar permission prompt (Add to calendar)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa adds the events you pick to your calendar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa adaugă în calendarul tău evenimentele pe care le alegi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa ajoute à ton calendrier les événements que tu choisis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa añade a tu calendario los eventos que elijas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa aggiunge al tuo calendario gli eventi che scegli."
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "comment": "Calendar permission prompt (Add to calendar)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa adds the events you pick to your calendar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa adaugă în calendarul tău evenimentele pe care le alegi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa ajoute à ton calendrier les événements que tu choisis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa añade a tu calendario los eventos que elijas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa aggiunge al tuo calendario gli eventi che scegli."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Camera permission prompt (Take photo)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa uses the camera to take photos for your posts, items, profile and chat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa folosește camera ca să faci poze pentru postări, obiecte, profil și chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa utilise l’appareil photo pour prendre des photos pour tes posts, objets, profil et chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa usa la cámara para hacer fotos para tus publicaciones, artículos, perfil y chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa usa la fotocamera per scattare foto per i tuoi post, oggetti, profilo e chat."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Photo library permission prompt",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa uses your photos for avatars, food posts and marketplace items."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa folosește fotografiile tale pentru avatare, postări cu mâncare și obiecte din Piață."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa utilise tes photos pour les avatars, les publications culinaires et les articles du marché."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa usa tus fotos para avatares, publicaciones de comida y artículos del mercadillo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa usa le tue foto per avatar, post di cibo e oggetti del Mercatino."
          }
        }
      }
    }
  }
}