    "NSPhotoLibraryUsageDescription": {
      "comment": "Photo library permission prompt",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa uses your photos for avatars, food posts and marketplace items."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa folosește fotografiile tale pentru avatare, postări cu mâncare și articole din piață."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa utilise tes photos pour les avatars, les publications culinaires et les articles du marché."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa usa tus fotos para avatares, publicaciones de comida y artículos del mercadillo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Boolaa usa le tue foto per avatar, post di cibo e articoli del mercatino."
          }
        }
      }
    }
  }
