        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous allons examiner ton signalement et agir s'il enfreint les règles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisaremos tu denuncia y tomaremos medidas si incumple las normas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esamineremo la tua segnalazione e interverremo se viola le regole."
          }
