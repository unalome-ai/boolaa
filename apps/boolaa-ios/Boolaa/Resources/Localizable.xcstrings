          }
        }
      }
    },
    "This can't be undone. Your profile, photos, messages, events, food posts, items and links will be permanently deleted, and you'll leave all your bubbles.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acțiunea nu poate fi anulată. Profilul, fotografiile, mesajele, evenimentele, postările cu mâncare, anunțurile și linkurile tale vor fi șterse definitiv și vei părăsi toate bulele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est irréversible. Ton profil, tes photos, messages, événements, publications culinaires, objets et liens seront définitivement supprimés, et tu quitteras toutes tes bulles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no se puede deshacer. Tu perfil, fotos, mensajes, eventos, publicaciones de comida, artículos y enlaces se eliminarán para siempre, y saldrás de todas tus burbujas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'operazione non si può annullare. Il tuo profilo, le foto, i messaggi, gli eventi, i post di cibo, gli oggetti e i link verranno eliminati definitivamente e lascerai tutte le tue bolle."
          }
        }
      }
    },
