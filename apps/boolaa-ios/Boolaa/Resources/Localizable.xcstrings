        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensi che sia un errore? Scrivici a [privacy@boolaa.ro](mailto:privacy@boolaa.ro) e spiegaci perché."
          }
        }
      }
    },
    "This account can't sign in right now: it's suspended or banned.": {
      "localizations": {
