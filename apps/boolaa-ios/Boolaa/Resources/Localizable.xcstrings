            "value": "Para asegurarnos de que eres tú, primero te enviaremos un código de 6 dígitos por correo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per essere sicuri che sei tu, prima ti mandiamo un codice di 6 cifre via email."
          }
