    "Bubbles you own pass to the longest-standing member. Bubbles with no one left are deleted.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulele pe care le deții trec la cel mai vechi membru. Bulele rămase fără membri sunt șterse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bulles dont tu es propriétaire passent au membre le plus ancien. Les bulles qui n'ont plus personne sont supprimées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las burbujas de las que eres propietario pasan al miembro más antiguo. Las burbujas que se quedan sin nadie se eliminan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bolle di cui sei proprietario passano al membro più anziano. Le bolle rimaste senza nessuno vengono eliminate."
          }
        }
      }
    },
