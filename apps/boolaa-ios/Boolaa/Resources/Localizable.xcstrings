            "value": "Non hai il permesso di farlo."
          }
        }
      }
    },
    "You won't see each other's messages, events, posts or links. You can unblock them in your profile.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu veți mai vedea unul altuia mesajele, evenimentele, postările sau linkurile. Poți debloca oricând din profilul tău."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne verrez plus les messages, événements, publications ou liens l'un de l'autre. Tu peux débloquer depuis ton profil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no veréis los mensajes, eventos, publicaciones ni enlaces del otro. Puedes desbloquear desde tu perfil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non vedrete più i messaggi, gli eventi, i post o i link l'uno dell'altro. Puoi sbloccare dal tuo profilo."
          }
        }
      }
    },
    "You'll need a new invite and the members' approval to come back.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vei avea nevoie de o nouă invitație și de aprobarea membrilor ca să revii."
