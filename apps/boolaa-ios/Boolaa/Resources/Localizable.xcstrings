          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis le code à 6 chiffres qu'on vient de t'envoyer. Ton compte sera supprimé juste après."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el código de 6 dígitos que te acabamos de enviar. Tu cuenta se eliminará justo después."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il codice di 6 cifre che ti abbiamo appena inviato. Il tuo account verrà eliminato subito dopo."
          }
        }
      }
    },
