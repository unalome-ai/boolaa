    "We just sent you an email. Wait a minute before asking for another.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocmai ți-am trimis un email. Așteaptă un minut înainte să ceri altul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On vient de t'envoyer un e-mail. Attends une minute avant d'en demander un autre."
