    "Blocked people can't see your messages, events, posts or links, and you won't see theirs.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Persoanele blocate nu-ți văd mesajele, evenimentele, postările sau linkurile, iar tu nu le vezi pe ale lor."
          }
        },
        "fr": {
          "stringUnit": {
