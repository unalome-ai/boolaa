    "To make sure it's you, we'll email you a 6-digit code first.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca să fim siguri că ești tu, îți trimitem mai întâi un cod din 6 cifre pe email."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour être sûrs que c'est bien toi, on t'envoie d'abord un code à 6 chiffres par e-mail."
          }
        },
        "es": {
          "stringUnit": {
