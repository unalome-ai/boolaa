          }
        }
      }
    },
    "Think this is a mistake? Write to [privacy@boolaa.ro](mailto:privacy@boolaa.ro) and tell us why.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Crezi că e o greșeală? Scrie-ne la [privacy@boolaa.ro](mailto:privacy@boolaa.ro) și spune-ne de ce."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu penses que c'est une erreur ? Écris-nous à [privacy@boolaa.ro](mailto:privacy@boolaa.ro) et explique-nous pourquoi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Crees que es un error? Escríbenos a [privacy@boolaa.ro](mailto:privacy@boolaa.ro) y cuéntanos por qué."
          }
