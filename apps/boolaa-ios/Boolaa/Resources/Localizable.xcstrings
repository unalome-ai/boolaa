    "Almost done: confirm the change from the emails we sent to your current address and to %@.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproape gata: confirmă schimbarea din emailurile trimise pe adresa actuală și la %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presque fini : confirme le changement depuis les e-mails envoyés à ton adresse actuelle et à %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi listo: confirma el cambio desde los correos que enviamos a tu dirección actual y a %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi fatto: conferma il cambio dalle email che abbiamo inviato al tuo indirizzo attuale e a %@."
          }
        }
      }
    },
