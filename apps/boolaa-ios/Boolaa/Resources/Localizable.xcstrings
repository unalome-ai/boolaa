{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ becomes the owner of %@. You'll lose your owner rights and become an admin: you won't be able to change roles, remove admins or take ownership back unless %@ gives it back." : {
      "comment" : "Transfer confirmation; arguments: new owner's name, bubble name, new owner's name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ becomes the owner of %2$@. You'll lose your owner rights and become an admin: you won't be able to change roles, remove admins or take ownership back unless %3$@ gives it back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pasa a ser propietario de %2$@. Pierdes tus derechos de propietario y pasas a ser admin: ya no podrás cambiar roles, quitar admins ni recuperar la propiedad, salvo que %3$@ te la devuelva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ devient propriétaire de %2$@. Tu perds tes droits de propriétaire et deviens admin : tu ne pourras plus changer les rôles, retirer des admins ni reprendre la propriété, sauf si %3$@ te la rend."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ diventa proprietario di %2$@. Perdi i diritti di proprietario e diventi admin: non potrai più cambiare i ruoli, rimuovere gli admin né riprenderti la proprietà, a meno che %3$@ non te la restituisca."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ devine proprietarul bulei %2$@. Pierzi drepturile de proprietar și devii admin: nu mai poți schimba roluri, elimina admini sau lua înapoi rolul de proprietar decât dacă ți-l cedează %3$@."
          }
        }
      }
    },
    "%@ gets your food. The post disappears from the Food Circle, and everyone else who asked will hear that someone else got it." : {
      "comment" : "Hand-over confirmation (food); the argument is the picked person's name",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu comida es para %@. La publicación desaparece del Círculo de comida y avisaremos al resto de quienes la pidieron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton plat va à %@. La publication disparaît du Cercle gourmand et les autres personnes qui l'ont demandé seront prévenues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo cibo va a %@. Il post sparisce dal Cerchio del cibo e avviseremo chi altro l'ha chiesto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mâncarea ajunge la %@. Postarea dispare din Cercul culinar, iar ceilalți care au cerut-o vor afla că a ajuns la altcineva."
          }
        }
      }
    },
    "%@ gets “%@”. Everyone else who asked will hear that someone else got it." : {
      "comment" : "Hand-over confirmation (market); arguments: the picked person's name, the item title",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%2$@» es para %1$@. Avisaremos al resto de quienes lo pidieron de que se lo ha llevado otra persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %2$@ » va à %1$@. Les autres personnes qui l'ont demandé seront prévenues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%2$@» va a %1$@. Avviseremo chi altro l'ha chiesto che è andato a qualcun altro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%2$@” ajunge la %1$@. Ceilalți care l-au cerut vor afla că a ajuns la altcineva."
          }
        }
      }
    },
    "%@ is no longer an admin." : {
      "comment" : "Notice after removing a member's admin role",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no es admin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'est plus admin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è più admin."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nu mai e admin."
          }
        }
      }
    },
    "%@ is now an admin." : {
      "comment" : "Notice after making a member an admin",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ahora es admin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est maintenant admin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ora è admin."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e acum admin."
          }
        }
      }
    },
    "%@ is now the owner." : {
      "comment" : "Notice after transferring ownership; the argument is the new owner's name",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ahora es el propietario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est maintenant propriétaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ora è il proprietario."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e acum proprietarul."
          }
        }
      }
    },
    "%@ will be told you changed your mind." : {
      "comment" : "Withdraw confirmation; the argument is the owner's name",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisaremos a %@ de que has cambiado de idea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ saura que tu as changé d'avis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avviseremo %@ che hai cambiato idea."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ va afla că te-ai răzgândit."
          }
        }
      }
    },
