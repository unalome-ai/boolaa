    },
    "This bubble is full.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bula este plină."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette bulle est complète."
