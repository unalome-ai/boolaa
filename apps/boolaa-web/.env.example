NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Web Push (public VAPID key; must match VAPID_PUBLIC_KEY of the push-dispatch function).
# Locally: copy VAPID_PUBLIC_KEY from supabase/functions/.env. Leave empty to hide push in the UI.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
