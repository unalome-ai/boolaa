<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand_purple">#9D78BD</color>
    <color name="background_light">#FAFAFA</color>
    <color name="background_dark">#18181B</color>
    <!-- AppCompat theme so per-app locales work through AppCompatDelegate; the UI itself is Compose + Material 3. -->
    <style name="Theme.Boolaa" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorPrimary">@color/brand_purple</item>
        <item name="colorAccent">@color/brand_purple</item>
    </style>
</resources>
