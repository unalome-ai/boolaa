<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Offline banner and reconnect (ConnectivityManager default network callback). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Push (docs/push-notifications.md §8): asked only after a user action (Settings → Notifications, Home card). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BoolaaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Boolaa"
        tools:targetApi="36">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- OAuth (Sign in with Apple in a Custom Tab) and email links return to ro.boolaa.app://auth/callback. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${authScheme}" android:host="auth" android:path="/callback" />
            </intent-filter>
            <!-- Invite links (docs/boolaa-spec.md, "Invite links"). Verified against https://boolaa.ro/.well-known/assetlinks.json
                 (release signing certificate); www is accepted too but not verified (it redirects to boolaa.ro). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="boolaa.ro" android:pathPrefix="/join/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.boolaa.ro" android:pathPrefix="/join/" />
            </intent-filter>
            <!-- Fallback when the App Link isn't verified: boolaa://join/CODE and ro.boolaa.app://join/CODE. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="boolaa" android:host="join" />
                <data android:scheme="${authScheme}" android:host="join" />
            </intent-filter>
        </activity>

        <!-- Push (FCM). No Google Analytics: firebase-analytics isn't a dependency, and collection is off in case a
             transitive library ever pulls it in. Background pushes are drawn by the system with these defaults. -->
        <service
            android:name=".push.BoolaaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="bubble" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_boolaa" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/brand_purple" />

        <!-- "Take photo": the system camera app writes the capture to a content Uri in cacheDir/camera/ (core/CameraCapture.kt).
             No CAMERA permission is declared on purpose: ACTION_IMAGE_CAPTURE needs none unless the app declares it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.camera"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/camera_paths" />
        </provider>

        <!-- Persists the per-app language below API 33 (AppCompatDelegate.setApplicationLocales). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
